{
  "name": "projector-wall-server",
  "version": "1.0.0",
  "scripts": {
    "dev": "wrangler dev --port 8787 --var LOCAL_DEV:true --var API_ORIGIN:http://127.0.0.1:8787",
    "deploy": "wrangler deploy",
    "typecheck": "tsc -p tsconfig.json",
    "test": "for f in test/*.test.ts; do esbuild \"$f\" --bundle --platform=node --log-level=warning --outfile=.wrangler/test/out.js && node .wrangler/test/out.js || exit 1; done"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250610.0",
    "typescript": "^5.6.3",
    "wrangler": "^4.20.0"
  },
  "private": true,
  "dependencies": {
    "@anthropic-ai/sdk": "^0.71.0"
  }
}
